//@version=5
// QSE v148 BOT VISUAL 2 · STRUKTUR DAN DASBOR
// Visual teknik robot Python QSE v148: struktur SMC (BOS, CHoCH, OB internal), MSB + zona HPZ, level SnR pivot 20,
// Order Block Finder, fib GZH (golden pocket 0.618-0.65, extension), trendline pivot 10, channel regresi 100,
// angka bulat, volume persentil 80, arah BTC resmi (EMA 50, toleransi 0.3%, 2 candle), mutu plus minus,
// jalur aktif 72 jam (COMBO), dan aturan portofolio. Pakai di chart 4J bersama QSE BOT 1.
indicator("QSE v148 BOT VISUAL 2 · Struktur dan Dasbor", shorttitle="QSE BOT 2", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=1000)

// ===== INPUT (hanya tampilan) =====
btcSym  = input.symbol("BYBIT:BTCUSDT.P", "Acuan BTC 4J")
shSMC   = input.bool(true, "SMC BOS / CHoCH + OB internal", group="Tampilan")
shMSB   = input.bool(true, "MSB + zona HPZ", group="Tampilan")
shSNR   = input.bool(true, "Level SnR pivot 20", group="Tampilan")
shOBF   = input.bool(true, "Order Block Finder (5 candle, gerak 2%)", group="Tampilan")
shGZH   = input.bool(true, "Fib GZH + golden pocket", group="Tampilan")
shTL    = input.bool(true, "Trendline pivot 10", group="Tampilan")
shCH    = input.bool(true, "Channel regresi 100", group="Tampilan")
shRN    = input.bool(true, "Angka bulat terdekat", group="Tampilan")
shVP    = input.bool(true, "Tanda volume persentil 80", group="Tampilan")
shDB    = input.bool(true, "Dasbor", group="Tampilan")
dbPos   = input.string("Bawah kanan", "Posisi dasbor", options=["Bawah kanan", "Bawah kiri", "Atas kiri"], group="Tampilan")

// ===== DATA DASAR =====
atr14 = ta.atr(14)
e20   = ta.ema(close, 20)
e50   = ta.ema(close, 50)
e200  = ta.ema(close, 200)
vp    = ta.percentrank(volume, 100)
okBar = bar_index >= 260
cBull = #00c853
cBear = #ff1744

f_btcResmi() =>
    float e = ta.ema(close, 50)
    float d = (close - e) / e * 100
    var int st = 0
    var int cnt = 0
    int sd = d > 0.3 ? 1 : d < -0.3 ? -1 : 0
    if sd == 0
        cnt := 0
    else if st == 0
        st := sd
    else if sd != st
        cnt += 1
        if cnt >= 2
            st := sd
            cnt := 0
    else
        cnt := 0
    [st == 0 ? (close > e ? 1 : -1) : st, d, close > e]
[btcRes, btcD, btcAtas] = request.security(btcSym, "240", f_btcResmi(), lookahead=barmerge.lookahead_off)
btcNaik  = not na(btcD) and btcAtas
btcTurun = not na(btcD) and not btcAtas

pivH(int len) =>
    high[len] > ta.highest(high, len)[len + 1] and high[len] >= ta.highest(high, len)
pivL(int len) =>
    low[len] < ta.lowest(low, len)[len + 1] and low[len] <= ta.lowest(low, len)

// ===== ICHIMOKU, EMA, RSI, McGINLEY (status jalur) =====
tk    = math.avg(ta.highest(high, 9), ta.lowest(low, 9))
kj    = math.avg(ta.highest(high, 26), ta.lowest(low, 26))
sa    = math.avg(tk, kj)[26]
sb    = math.avg(ta.highest(high, 52), ta.lowest(low, 52))[26]
ichiL = bar_index >= 120 and not na(sa) and not na(sb) and close > math.max(sa, sb) and tk > kj and tk[1] <= kj[1]
ichiS = bar_index >= 120 and not na(sa) and not na(sb) and close < math.min(sa, sb) and tk < kj and tk[1] >= kj[1]
emaS  = okBar and e20 < e50 and e20[1] >= e50[1] and close < e200 and btcTurun
rsi14 = ta.rsi(close, 14)
rsiL  = okBar and vp >= 80 and rsi14 > 50 and rsi14[1] <= 50 and close > e200 and e50 > e200
rsiS  = okBar and vp >= 80 and rsi14 < 50 and rsi14[1] >= 50 and close < e200 and e50 < e200
float md = na
md := na(md[1]) ? close : md[1] + (close - md[1]) / math.max(0.6 * 34 * math.pow(close / md[1], 4), 1.0)
mcgL  = okBar and vp >= 80 and close > md and close[1] <= md[1] and close > e200
mcgS  = okBar and vp >= 80 and close < md and close[1] >= md[1] and close < e200

// ===== SnR PIVOT 20 =====
snrPL = pivL(20)
snrPH = pivH(20)
snrL  = okBar and snrPL and close > low[20] and close > e200 and vp >= 80 and btcNaik
snrS  = okBar and snrPH and close < high[20] and close < e200 and vp >= 80 and btcTurun
var float snrR = na
var float snrSp = na
var lnR = array.new_line()
var lnS = array.new_line()
if snrPH
    snrR := high[20]
    if shSNR
        array.push(lnR, line.new(bar_index - 20, high[20], bar_index, high[20], extend=extend.right, color=color.new(cBear, 30), width=1, style=line.style_dashed))
        if array.size(lnR) > 3
            line.delete(array.shift(lnR))
if snrPL
    snrSp := low[20]
    if shSNR
        array.push(lnS, line.new(bar_index - 20, low[20], bar_index, low[20], extend=extend.right, color=color.new(cBull, 30), width=1, style=line.style_dashed))
        if array.size(lnS) > 3
            line.delete(array.shift(lnS))

// ===== MSB + HPZ =====
ph7 = pivH(7)
pl7 = pivL(7)
var float lph  = na
var int   lphI = 0
var float lpl  = na
var int   lplI = 0
if ph7
    lph  := high[7]
    lphI := bar_index - 7
if pl7
    lpl  := low[7]
    lplI := bar_index - 7
chg = nz(ta.change(close))
zm  = ta.sma(chg, 50)
zs  = ta.stdev(chg, 50)
zz  = zs == 0 ? 0.0 : (chg - zm) / zs
mBull = bar_index >= 60 and not na(lph) and close > lph and close[1] <= lph and zz > 0.5
mBear = bar_index >= 60 and not na(lpl) and close < lpl and close[1] >= lpl and zz < -0.5
mSc   = math.min(100.0, math.abs(zz) * 20 + nz(vp) * 0.5)
var int   msbDir = 0
var float msbSc  = na
if mBull or mBear
    msbDir := mBull ? 1 : -1
    msbSc  := mSc
    if shMSB
        float lv = mBull ? lph : lpl
        int   li = mBull ? lphI : lplI
        line.new(li, lv, bar_index, lv, color=mBull ? cBull : cBear, width=1)
        label.new(bar_index, lv, "MSB " + str.tostring(mSc, "#"), style=label.style_none, textcolor=mBull ? cBull : cBear, size=size.tiny)
        if mSc > 80
            int k0 = 0
            for k = 1 to 10
                if (mBull and close[k] < open[k]) or (mBear and close[k] > open[k])
                    k0 := k
                    break
            box.new(bar_index - k0, high[k0], bar_index + 20, low[k0], border_color=color.new(mBull ? cBull : cBear, 40),
                 bgcolor=color.new(mBull ? cBull : cBear, 85), text="HPZ " + str.tostring(mSc, "#"), text_color=color.new(color.white, 30), text_size=size.tiny)
if mBull
    lph := na
if mBear
    lpl := na
msbL = okBar and mBull and mSc > 80 and close > e200
msbS = okBar and mBear and mSc > 80 and close < e200

// ===== SMC LUXALGO (internal 5, swing 50) =====
f_leg(int size) =>
    var int leg = 0
    float hh = ta.highest(high, size)
    float ll = ta.lowest(low, size)
    int nw = leg
    if high[size] > hh
        nw := 0
    else if low[size] < ll
        nw := 1
    bool nH = nw != leg and nw == 0
    bool nL = nw != leg and nw == 1
    leg := nw
    [nH, nL]
[iNH, iNL] = f_leg(5)
[sNH, sNL] = f_leg(50)
a200 = ta.atr(200)
hvb  = (high - low) >= 2 * nz(a200, 1e12)
phS  = hvb ? low : high
plS  = hvb ? high : low
var float sHv = na
var int   sHi = 0
var bool  sHx = true
var float sLv = na
var int   sLi = 0
var bool  sLx = true
var float iHv = na
var int   iHi = 0
var bool  iHx = true
var float iLv = na
var int   iLi = 0
var bool  iLx = true
var int   itr = 0
var int   strd = 0
var string smcTag = "-"
if sNH
    sHv := high[50]
    sHi := bar_index - 50
    sHx := false
if sNL
    sLv := low[50]
    sLi := bar_index - 50
    sLx := false
if iNH
    iHv := high[5]
    iHi := bar_index - 5
    iHx := false
if iNL
    iLv := low[5]
    iLi := bar_index - 5
    iLx := false
if not sHx and not na(sHv) and close > sHv and close[1] <= sHv
    sHx := true
    bool chs = strd == -1
    strd := 1
    if shSMC
        line.new(sHi, sHv, bar_index, sHv, color=cBull, width=2)
        label.new(math.round((sHi + bar_index) / 2), sHv, chs ? "Swing CHoCH" : "Swing BOS", style=label.style_label_down, color=color.new(color.black, 100), textcolor=cBull, size=size.small)
if not sLx and not na(sLv) and close < sLv and close[1] >= sLv
    sLx := true
    bool chs2 = strd == 1
    strd := -1
    if shSMC
        line.new(sLi, sLv, bar_index, sLv, color=cBear, width=2)
        label.new(math.round((sLi + bar_index) / 2), sLv, chs2 ? "Swing CHoCH" : "Swing BOS", style=label.style_label_up, color=color.new(color.black, 100), textcolor=cBear, size=size.small)
bool chochL = false
bool chochS = false
if not iHx and not na(iHv) and (na(sHv) or iHv != sHv) and close > iHv and close[1] <= iHv
    chochL := itr == -1
    smcTag := chochL ? "CHoCH naik" : "BOS naik"
    iHx := true
    itr := 1
    if shSMC
        line.new(iHi, iHv, bar_index, iHv, color=color.new(cBull, 20), width=1, style=line.style_dashed)
        label.new(math.round((iHi + bar_index) / 2), iHv, chochL ? "CHoCH" : "BOS", style=label.style_label_down, color=color.new(color.black, 100), textcolor=cBull, size=size.tiny)
        int span = math.min(bar_index - iHi, 300)
        int jb = 1
        float mn = plS[1]
        for o = 1 to span
            if plS[o] < mn
                mn := plS[o]
                jb := o
        box.new(bar_index - jb, phS[jb], bar_index + 15, plS[jb], border_color=color.new(cBull, chochL ? 20 : 60), bgcolor=color.new(cBull, chochL ? 80 : 92),
             text=chochL ? "OB CHoCH" : "OB", text_color=color.new(color.white, 40), text_size=size.tiny)
if not iLx and not na(iLv) and (na(sLv) or iLv != sLv) and close < iLv and close[1] >= iLv
    chochS := itr == 1
    smcTag := chochS ? "CHoCH turun" : "BOS turun"
    iLx := true
    itr := -1
    if shSMC
        line.new(iLi, iLv, bar_index, iLv, color=color.new(cBear, 20), width=1, style=line.style_dashed)
        label.new(math.round((iLi + bar_index) / 2), iLv, chochS ? "CHoCH" : "BOS", style=label.style_label_up, color=color.new(color.black, 100), textcolor=cBear, size=size.tiny)
        int span2 = math.min(bar_index - iLi, 300)
        int js = 1
        float mx = phS[1]
        for o = 1 to span2
            if phS[o] > mx
                mx := phS[o]
                js := o
        box.new(bar_index - js, phS[js], bar_index + 15, plS[js], border_color=color.new(cBear, chochS ? 20 : 60), bgcolor=color.new(cBear, chochS ? 80 : 92),
             text=chochS ? "OB CHoCH" : "OB", text_color=color.new(color.white, 40), text_size=size.tiny)
smcL = okBar and chochL and close > e200
smcS = okBar and chochS and close < e200

// ===== ORDER BLOCK FINDER =====
greens = close > open and close[1] > open[1] and close[2] > open[2] and close[3] > open[3] and close[4] > open[4]
reds   = close < open and close[1] < open[1] and close[2] < open[2] and close[3] < open[3] and close[4] < open[4]
gerak  = math.abs(close[5] - close) / close[5] * 100
obfB   = bar_index >= 6 and close[5] < open[5] and greens and gerak >= 2.0
obfS   = bar_index >= 6 and close[5] > open[5] and reds and gerak >= 2.0
obRaw  = bar_index >= 210 and obfB and close > e200 and vp >= 80
var string obTxt = "-"
if obfB
    obTxt := obRaw ? (btcNaik ? "OB LONG lolos syarat bot" : "OB lolos, BTC 4J di bawah EMA 50") : "OB tanpa syarat volume atau EMA 200"
    if shOBF
        box.new(bar_index - 5, open[5], bar_index + 20, low[5], border_color=color.new(cBull, obRaw ? 0 : 60), bgcolor=color.new(cBull, obRaw ? 70 : 90),
             text=obRaw ? "OB +VOL" : "OBF", text_color=color.new(color.white, 30), text_size=size.tiny)
if obfS and shOBF
    box.new(bar_index - 5, high[5], bar_index + 20, open[5], border_color=color.new(cBear, 60), bgcolor=color.new(cBear, 90),
         text="OBF", text_color=color.new(color.white, 40), text_size=size.tiny)

// ===== GZH ZIGZAG + FIB =====
gzAtr = ta.atr(10)
var float zP   = 0.0
var int   zI   = 0
var bool  zHi  = false
var float zY1  = 0.0
var int   zY1i = 0
var bool  zAda = false
var float uS   = na
var float uE   = na
bool gzL = false
bool gzS = false
legOK = zAda and zY1 != 0 and not na(gzAtr[1])
gSt   = zP
gEn   = zY1
gIsL  = gSt > gEn
g618  = gSt + (gIsL ? -1 : 1) * math.abs(gSt - gEn) * 0.618
gUsed = gSt == uS and gEn == uE
if legOK and not gUsed and bar_index > zI
    bool kena = gIsL ? (low <= g618 and g618 < close[1]) : (high >= g618 and g618 > close[1])
    if kena
        uS := gSt
        uE := gEn
        bool konf = gIsL ? close > g618 : close < g618
        bool tpOk = gIsL ? gSt > close : gSt < close
        bool srh  = gIsL ? (close > e200 and btcNaik) : (close < e200 and btcTurun)
        if konf and tpOk and srh and okBar
            if gIsL
                gzL := true
            else
                gzS := true
thrT = na(gzAtr) ? 1e9 : gzAtr / close * 100 * 4.0
wH = ta.highest(high, 11)
wL = ta.lowest(low, 11)
isPH = bar_index >= 10 and high[5] >= wH
isPL = bar_index >= 10 and low[5] <= wL
if isPH
    float p = high[5]
    float dev = 100 * (p - zP) / p
    if zHi and zAda
        if p > zP
            zP := p
            zI := bar_index - 5
    else if math.abs(dev) > thrT
        zY1  := zP
        zY1i := zI
        zAda := true
        zP   := p
        zI   := bar_index - 5
        zHi  := true
if isPL and not isPH
    float p2 = low[5]
    float dev2 = 100 * (p2 - zP) / p2
    if not zHi and zAda
        if p2 < zP
            zP := p2
            zI := bar_index - 5
    else if math.abs(dev2) > thrT
        zY1  := zP
        zY1i := zI
        zAda := true
        zP   := p2
        zI   := bar_index - 5
        zHi  := false

// ===== TRENDLINE PIVOT 10 =====
tpH = ta.pivothigh(high, 10, 10)
tpL = ta.pivotlow(low, 10, 10)
var float th1 = na
var float th2 = na
var int th1i = na
var int th2i = na
var float tl1 = na
var float tl2 = na
var int tl1i = na
var int tl2i = na
if not na(tpH)
    th2  := th1
    th2i := th1i
    th1  := tpH
    th1i := bar_index - 10
if not na(tpL)
    tl2  := tl1
    tl2i := tl1i
    tl1  := tpL
    tl1i := bar_index - 10
slpH = not na(th1) and not na(th2) and th1i != th2i ? (th1 - th2) / (th1i - th2i) : 0.0
slpL = not na(tl1) and not na(tl2) and tl1i != tl2i ? (tl1 - tl2) / (tl1i - tl2i) : 0.0
tlHv = na(th1) ? na : th1 + slpH * (bar_index - th1i)
tlLv = na(tl1) ? na : tl1 + slpL * (bar_index - tl1i)
rvol = volume / ta.sma(volume, 20)
tlBU = not na(tlHv) and close > tlHv and close[1] <= nz(tlHv[1], tlHv)
tlBD = not na(tlLv) and close < tlLv and close[1] >= nz(tlLv[1], tlLv)
ttS  = okBar and tlBD and rvol >= 1.2 and close < e200
var int ttBar = -1000
if ttS
    ttBar := bar_index

// ===== MUTU =====
hh20 = ta.highest(high, 20)[1]
ll20 = ta.lowest(low, 20)[1]
fbL  = low < ll20 and close > ll20
fbS  = high > hh20 and close < hh20
lr0  = ta.linreg(close, 100, 0)
lr1  = ta.linreg(close, 100, 1)
sdy  = ta.stdev(close, 100)
rr   = ta.correlation(close, bar_index, 100)
resSd = sdy * math.sqrt(math.max(1 - rr * rr, 0))
chZ  = (close - lr0) / (resSd > 0 ? resSd : 1e-9)
[macL, macSig, macH] = ta.macd(close, 12, 26, 9)
[dip, dim, adxV] = ta.dmi(14, 14)
stp  = math.pow(10, math.floor(math.log10(close))) / 2
nxL  = (math.floor(close / stp) + 1) * stp
nxS  = (math.ceil(close / stp) - 1) * stp
rnL  = math.abs(nxL - close) <= 1.5 * atr14
rnS  = math.abs(nxS - close) <= 1.5 * atr14
tipL = (close - hh20) > 0 and (close - hh20) < 0.25 * atr14
tipS = (ll20 - close) > 0 and (ll20 - close) < 0.25 * atr14
plusL  = (fbL ? 1 : 0) + (chZ > 1 ? 1 : 0) + (macH > 0 ? 1 : 0) + (adxV < 20 ? 1 : 0)
minusL = (adxV > 25 ? 1 : 0) + (rnL ? 1 : 0) + (tipL ? 1 : 0) + (chZ < -1 ? 1 : 0) + (macL > 0 ? 1 : 0)
plusS  = (fbS ? 1 : 0) + (chZ < -1 ? 1 : 0) + (macH < 0 ? 1 : 0) + (adxV < 20 ? 1 : 0)
minusS = (adxV > 25 ? 1 : 0) + (rnS ? 1 : 0) + (tipS ? 1 : 0) + (chZ > 1 ? 1 : 0) + (macL < 0 ? 1 : 0)
f_mutu(bool isL) =>
    string pl = isL ? ((fbL ? "jebakan lawan, " : "") + (chZ > 1 ? "atas channel, " : "") + (macH > 0 ? "MACD hist, " : "") + (adxV < 20 ? "ADX<20, " : "")) :
         ((fbS ? "jebakan lawan, " : "") + (chZ < -1 ? "bawah channel, " : "") + (macH < 0 ? "MACD hist, " : "") + (adxV < 20 ? "ADX<20, " : ""))
    string mi = isL ? ((adxV > 25 ? "ADX>25, " : "") + (rnL ? "angka bulat, " : "") + (tipL ? "tembus tipis, " : "") + (chZ < -1 ? "sisi lawan channel, " : "") + (macL > 0 ? "MACD di atas nol, " : "")) :
         ((adxV > 25 ? "ADX>25, " : "") + (rnS ? "angka bulat, " : "") + (tipS ? "tembus tipis, " : "") + (chZ > 1 ? "sisi lawan channel, " : "") + (macL < 0 ? "MACD di bawah nol, " : ""))
    int np = isL ? plusL : plusS
    int nm = isL ? minusL : minusS
    string st = np - nm <= -2 ? "BUANG" : np >= 3 ? "MUTU TINGGI" : "normal"
    st + " (+" + str.tostring(np) + " / -" + str.tostring(nm) + ")" + (pl != "" ? " plus: " + str.substring(pl, 0, str.length(pl) - 2) : "") + (mi != "" ? " · minus: " + str.substring(mi, 0, str.length(mi) - 2) : "")

// ===== JALUR AKTIF 72 JAM (18 candle) =====
var NAMA  = array.from("Ichimoku", "Order Block", "EMA SHORT", "RSI 50+Vol", "SnR+Vol", "MSB HPZ", "SMC CHoCH", "McGinley 34", "GZH")
var lastL = array.new_int(9, -1000)
var lastS = array.new_int(9, -1000)
if ichiL
    array.set(lastL, 0, bar_index)
if ichiS
    array.set(lastS, 0, bar_index)
if obRaw
    array.set(lastL, 1, bar_index)
if emaS
    array.set(lastS, 2, bar_index)
if rsiL
    array.set(lastL, 3, bar_index)
if rsiS
    array.set(lastS, 3, bar_index)
if snrL
    array.set(lastL, 4, bar_index)
if snrS
    array.set(lastS, 4, bar_index)
if msbL
    array.set(lastL, 5, bar_index)
if msbS
    array.set(lastS, 5, bar_index)
if smcL
    array.set(lastL, 6, bar_index)
if smcS
    array.set(lastS, 6, bar_index)
if mcgL
    array.set(lastL, 7, bar_index)
if mcgS
    array.set(lastS, 7, bar_index)
if gzL
    array.set(lastL, 8, bar_index)
if gzS
    array.set(lastS, 8, bar_index)
f_aktif(bool isL) =>
    string t = ""
    int n = 0
    for j = 0 to 8
        int lb = isL ? array.get(lastL, j) : array.get(lastS, j)
        if bar_index - lb <= 17
            n += 1
            t := t + (t == "" ? "" : ", ") + array.get(NAMA, j) + " (" + str.tostring(bar_index - lb) + ")"
    [n, t == "" ? "tidak ada" : t]

// ===== GAMBAR DI CANDLE TERAKHIR =====
var line[] gzLines = array.new_line()
var label[] gzLbls = array.new_label()
var box gzBox = na
var line tlA = na
var line tlB = na
var line chM = na
var line chU = na
var line chD = na
var line rnA = na
var line rnB = na
var label rnLa = na
var label rnLb = na
f_lv(float s, float e, float m) =>
    s + (s > e ? -1 : 1) * math.abs(s - e) * m
if barstate.islast
    // fib GZH
    for l in gzLines
        line.delete(l)
    for b in gzLbls
        label.delete(b)
    array.clear(gzLines)
    array.clear(gzLbls)
    box.delete(gzBox)
    if shGZH and zAda and zY1 != 0
        bool L = zP > zY1
        float e618 = f_lv(zP, zY1, 0.618)
        int span = math.min(bar_index - zI, 500)
        bool sudah = false
        if span >= 1
            for o = 0 to span - 1
                if L ? low[o] <= e618 : high[o] >= e618
                    sudah := true
                    break
        array.push(gzLines, line.new(zY1i, zY1, zI, zP, color=color.new(#ffd600, 30), width=1, style=line.style_dotted))
        lvls = array.from(-1.0, -0.618, -0.236, 0.0, 0.5, 0.618, 0.65, 0.786, 1.0)
        for m in lvls
            float y = f_lv(zP, zY1, m)
            color c = m == 0.618 or m == 0.65 ? #ffd600 : m < 0 ? color.new(#00e5ff, 30) : color.new(color.gray, 30)
            array.push(gzLines, line.new(zI, y, bar_index + 10, y, color=c, width=m == 0.618 ? 2 : 1))
            array.push(gzLbls, label.new(bar_index + 10, y, str.tostring(m) + "  " + str.tostring(y, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=c, size=size.tiny))
        gzBox := box.new(zI, f_lv(zP, zY1, 0.618), bar_index + 10, f_lv(zP, zY1, 0.65), border_color=color.new(#ffd600, 50), bgcolor=color.new(#ffd600, 85),
             text="GZH " + (L ? "LONG" : "SHORT") + (sudah ? " · 0.618 sudah disentuh" : " · menunggu sentuhan 0.618"), text_color=color.new(color.white, 20), text_size=size.tiny)
    // trendline
    line.delete(tlA)
    line.delete(tlB)
    if shTL and not na(th2) and not na(th1)
        tlA := line.new(th2i, th2, th1i, th1, extend=extend.right, color=color.new(cBear, 20), width=1)
    if shTL and not na(tl2) and not na(tl1)
        tlB := line.new(tl2i, tl2, tl1i, tl1, extend=extend.right, color=color.new(cBull, 20), width=1)
    // channel regresi 100
    line.delete(chM)
    line.delete(chU)
    line.delete(chD)
    if shCH and not na(lr0)
        float slope = lr0 - lr1
        float st0 = lr0 - slope * 99
        chM := line.new(bar_index - 99, st0, bar_index, lr0, color=color.new(color.silver, 40), style=line.style_dashed)
        chU := line.new(bar_index - 99, st0 + resSd, bar_index, lr0 + resSd, color=color.new(color.silver, 60))
        chD := line.new(bar_index - 99, st0 - resSd, bar_index, lr0 - resSd, color=color.new(color.silver, 60))
    // angka bulat
    line.delete(rnA)
    line.delete(rnB)
    label.delete(rnLa)
    label.delete(rnLb)
    if shRN
        rnA := line.new(bar_index - 30, nxL, bar_index + 10, nxL, color=color.new(#b388ff, 30), style=line.style_dotted)
        rnB := line.new(bar_index - 30, nxS, bar_index + 10, nxS, color=color.new(#b388ff, 30), style=line.style_dotted)
        rnLa := label.new(bar_index - 30, nxL, "angka bulat " + str.tostring(nxL), style=label.style_label_right, color=color.new(color.black, 100), textcolor=#b388ff, size=size.tiny)
        rnLb := label.new(bar_index - 30, nxS, "angka bulat " + str.tostring(nxS), style=label.style_label_right, color=color.new(color.black, 100), textcolor=#b388ff, size=size.tiny)

plotshape(shTL and tlBU, "Tembus trendline atas", shape.circle, location.belowbar, color.new(cBull, 40), size=size.tiny)
plotshape(shTL and tlBD and not ttS, "Tembus trendline bawah", shape.circle, location.abovebar, color.new(cBear, 40), size=size.tiny)
plotshape(shTL and ttS, "Tembus Trendline SHORT searah tren", shape.xcross, location.abovebar, #ff6d00, text="TT", size=size.small)
plotshape(shVP and vp >= 80, "Volume persentil 80", shape.square, location.bottom, color.new(#ff9100, 40), size=size.tiny)

// ===== DASBOR =====
turn = math.sum(close * volume, 180)
pos = dbPos == "Bawah kiri" ? position.bottom_left : dbPos == "Atas kiri" ? position.top_left : position.bottom_right
var table db = table.new(pos, 2, 21, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)
f_row(int r, string a, string b, color fb) =>
    table.cell(db, 0, r, a, bgcolor=color.new(#263238, 0), text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(db, 1, r, b, bgcolor=color.new(#11161c, 10), text_color=fb, text_size=size.tiny, text_halign=text.align_left)
f_fmt(float x) =>
    str.tostring(x, format.mintick)
if barstate.islast and shDB
    float dE = (close - e200) / e200 * 100
    [nL, tL] = f_aktif(true)
    [nS, tS] = f_aktif(false)
    bool L = zP > zY1
    float e618 = f_lv(zP, zY1, 0.618)
    float jr = atr14 > 0 ? math.abs(close - e618) / atr14 : 0.0
    f_row(0, "QSE v148 BOT 2", syminfo.ticker + " · TF " + timeframe.period + (timeframe.period != "240" ? " · PAKAI CHART 4J" : ""), timeframe.period != "240" ? #ffd600 : color.white)
    f_row(1, "BTC 4J resmi", (btcRes == 1 ? "condong LONG" : "condong SHORT") + " · " + str.tostring(btcD, "#.##") + "% dari EMA 50 · pindah setelah 2 candle lewat 0.3%", btcRes == 1 ? cBull : cBear)
    f_row(2, "Tren besar", (close > e200 ? "di atas" : "di bawah") + " EMA 200 (" + str.tostring(dE, "#.##") + "%)", close > e200 ? cBull : cBear)
    f_row(3, "Volume", "persentil " + str.tostring(vp, "#") + " dari 100 candle" + (vp >= 80 ? " · LOLOS 80" : " · belum 80"), vp >= 80 ? #ff9100 : color.gray)
    f_row(4, "Ichimoku", (close > math.max(sa, sb) ? "di atas awan" : close < math.min(sa, sb) ? "di bawah awan" : "di dalam awan") + " · Tenkan " + (tk > kj ? "di atas" : "di bawah") + " Kijun", close > math.max(sa, sb) ? cBull : close < math.min(sa, sb) ? cBear : color.gray)
    f_row(5, "EMA 20/50", "EMA 20 " + (e20 > e50 ? "di atas" : "di bawah") + " EMA 50 · EMA SHORT butuh potong ke bawah + BTC di bawah EMA 50", e20 > e50 ? cBull : cBear)
    f_row(6, "RSI 14", str.tostring(rsi14, "#.#") + (rsi14 > 50 ? " · di atas 50" : " · di bawah 50"), rsi14 > 50 ? cBull : cBear)
    f_row(7, "McGinley 34", "harga " + (close > md ? "di atas " : "di bawah ") + f_fmt(md), close > md ? cBull : cBear)
    f_row(8, "SnR pivot 20", "R " + (na(snrR) ? "-" : f_fmt(snrR)) + " · S " + (na(snrSp) ? "-" : f_fmt(snrSp)), color.white)
    f_row(9, "MSB terakhir", msbDir == 0 ? "-" : (msbDir == 1 ? "tembus naik" : "tembus turun") + " · skor " + str.tostring(msbSc, "#") + (msbSc > 80 ? " (HPZ)" : ""), msbDir == 1 ? cBull : msbDir == -1 ? cBear : color.gray)
    f_row(10, "SMC internal", smcTag + " · struktur " + (itr == 1 ? "naik" : itr == -1 ? "turun" : "-") + " · swing " + (strd == 1 ? "naik" : strd == -1 ? "turun" : "-"), itr == 1 ? cBull : itr == -1 ? cBear : color.gray)
    f_row(11, "Order Block", obTxt, color.white)
    f_row(12, "GZH", zAda and zY1 != 0 ? ((L ? "kaki LONG" : "kaki SHORT") + " · 0.618 di " + f_fmt(e618) + " · jarak " + str.tostring(jr, "#.#") + " ATR · syarat: searah EMA 200 + BTC") : "kaki fib belum terbentuk", #ffd600)
    f_row(13, "Trendline", bar_index - ttBar <= 2 ? "Tembus Trendline SHORT baru (" + str.tostring(bar_index - ttBar) + " candle) · level dari DASBOR" : "atas " + (na(tlHv) ? "-" : f_fmt(tlHv)) + " · bawah " + (na(tlLv) ? "-" : f_fmt(tlLv)), bar_index - ttBar <= 2 ? #ff6d00 : color.white)
    f_row(14, "Mutu LONG", f_mutu(true), plusL - minusL <= -2 ? cBear : plusL >= 3 ? #00e5ff : color.white)
    f_row(15, "Mutu SHORT", f_mutu(false), plusS - minusS <= -2 ? cBear : plusS >= 3 ? #00e5ff : color.white)
    f_row(16, "Jalur LONG 72 jam", tL + (nL >= 2 ? " · COMBO " + str.tostring(nL) : ""), nL > 0 ? cBull : color.gray)
    f_row(17, "Jalur SHORT 72 jam", tS + (nS >= 2 ? " · COMBO " + str.tostring(nS) : ""), nS > 0 ? cBear : color.gray)
    f_row(18, "Likuiditas", "nilai transaksi 30 hari " + str.tostring(turn / 1e6, "#,###.#") + " juta USDT · Ichimoku top 20, RSI SnR MSB SMC top 30, OB top 50", color.silver)
    f_row(19, "Portofolio bot", "maks 16 posisi searah, SMC MSB GZH saat kurang dari 8, satu koin satu jalur, risiko 0.25%, rem 32R", color.silver)
    f_row(20, "Batas masuk", "MARKET dalam 0.5R dari entry dan maks 2 candle. MSB, OB, GZH hanya candle sinyal. SL di atas 10% dilewati", color.silver)
